{
  "expo": {
    "name": "Howdy Morning",
    "slug": "howdymorning",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "howdymorning",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.howdymorning.app",
      "associatedDomains": ["applinks:howdymornin.io"],
      "infoPlist": {
        "NSHealthShareUsageDescription": "Howdy Morning reads Apple Health activity, weight, and sleep data to personalize your energy schedule and calorie goals.",
        "NSHealthUpdateUsageDescription": "Howdy Morning can write nutrition totals to Apple Health when you choose to sync your food journal.",
        "NSCameraUsageDescription": "Howdy Morning uses the camera to scan food barcodes."
      }
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "https", "host": "howdymornin.io" }]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#ffffff"
      },
      "package": "io.howdymorning.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#020617"
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Howdy Morning reads Apple Health activity, weight, and sleep data to personalize your energy schedule and calorie goals.",
          "NSHealthUpdateUsageDescription": "Howdy Morning can write nutrition totals to Apple Health when you choose to sync your food journal."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
